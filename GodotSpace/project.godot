; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GodotSpace"
run/main_scene="uid://bxjf7sbtop7t6"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"

[arspace]

local_agent/enabled=true
local_agent/mode="enabled"
local_agent/endpoint_url="ws://127.0.0.1:7861/ws/godot"
local_agent/max_message_bytes=262144
llm_assistant/endpoint_url="https://api.deepseek.com/chat/completions"
llm_assistant/model="deepseek-v4-pro"
llm_assistant/api_key_environment_name="DEEPSEEK_API_KEY"
llm_assistant/require_wake_word=true
llm_assistant/wake_words=PackedStringArray("助手", "智能助手", "LLM")
llm_assistant/max_context_entries=5
llm_assistant/max_conversation_turns=6
llm_assistant/use_local_fallback_when_unconfigured=true
llm_assistant/knowledge_base_path="res://Assets/ARSpace/Data/llm_knowledge_base.json"
llm_assistant/knowledge_directories=PackedStringArray("res://Assets/ARSpace/Data/Knowledge", "res://Assets/StreamingAssets/Knowledge", "user://llm_knowledge")

[audio]

general/text_to_speech=true
driver/enable_input=true
driver/mix_rate=48000

[autoload]

XRToolsUserSettings="*res://addons/godot-xr-tools/user_settings/user_settings.gd"
XRToolsRumbleManager="*res://addons/godot-xr-tools/rumble/rumble_manager.gd"
Global="*res://Assets/ARSpace/Scripts/Global.gd"
NetworkHandler="*res://Assets/ARSpace/Scripts/Network/network_handler.gd"
VoiceChat="*res://Assets/ARSpace/Scenes/voice_chat_service.tscn"
LLMAssistantService="*res://Assets/ARSpace/Scripts/AI/llm_assistant.gd"
LocalAgentClient="*res://Assets/ARSpace/Scripts/AI/LocalAgent/local_agent_client.gd"
AssistantCommandRouter="*res://Assets/ARSpace/Scripts/AI/LocalAgent/assistant_command_router.gd"
OrbitalManager="*res://addons/orbital_tools/orbital_manager.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-xr-tools/plugin.cfg", "res://addons/orbital_tools/plugin.cfg", "res://addons/unidot/plugin.cfg")

[filesystem]

import/blender/enabled=false

